// Soppo-generated ? operator patterns.
// Benchmarks for the ? operator with various return types.
//
// Helper functions use //go:noinline to prevent the compiler from inlining and
// constant-folding them away, which would turn the benchmark into a no-op.
package runtime

import (
	"errors"
	"fmt"
	"testing"
)

var (
	errEmpty = errors.New("empty string")
	errInvalid = errors.New("invalid id")
)

type UserTry struct {
	name string
	age  int
}

//go:noinline
func parsePortTry(s string) (int, error) {
	if s == "" {
		return 0, errEmpty
	}
	return 8080, nil
}

//go:noinline
func getUserTry(id int) (?*UserTry, error) {
	if id <= 0 {
		return nil, errInvalid
	}
	return &UserTry{name: "Alice", age: 30}, nil
}

//go:noinline
func processOrderGenerated(id string) (int, error) {
	port := parsePortTry(id) ?
	user := getUserTry(port) ?
	return user.age, nil
}

//go:noinline
func processOrderGeneratedWrapped(id string) (int, error) {
	port := parsePortTry(id) ? err {
		return 0, fmt.Errorf("parse failed: %w", err)
	}
	user := getUserTry(port) ? err {
		return 0, fmt.Errorf("get user failed: %w", err)
	}
	return user.age, nil
}

func BenchmarkTryPropagateGenerated(b *testing.B) {
	var sinkI int
	var sinkE ?error
	for b.Loop() {
		sinkI, sinkE = processOrderGenerated("8080")
	}
	_ = sinkI
	_ = sinkE
}

func BenchmarkTryPropagateErrorGenerated(b *testing.B) {
	var sinkI int
	var sinkE ?error
	for b.Loop() {
		sinkI, sinkE = processOrderGenerated("")
	}
	_ = sinkI
	_ = sinkE
}

func BenchmarkTryWrappedGenerated(b *testing.B) {
	var sinkI int
	var sinkE ?error
	for b.Loop() {
		sinkI, sinkE = processOrderGeneratedWrapped("8080")
	}
	_ = sinkI
	_ = sinkE
}
