package main

import "fmt"
import "github.com/halcyonnouveau/soppo/runtime"
import "github.com/test/attributes/attrs"

// Function with attribute using enum value
[attrs.Route{Path: "/users", Method: attrs.Method.Get}]
func GetUsers() string {
    return "users"
}

[attrs.Route{Path: "/users", Method: attrs.Method.Post}]
func CreateUser() string {
    return "created"
}

// Type with attribute
[attrs.Route{Path: "/api", Method: attrs.Method.Get}]
type Handler struct {
    Name string
}

// Struct with field attributes
type User struct {
    [attrs.Column{Name: "user_id", PrimaryKey: true}]
    ID string

    [attrs.Column{Name: "email"}]
    Email string
}

func main() {
    _ = GetUsers()

    // Query function attribute with enum
    route, found := runtime.GetAttr[attrs.Route]("main.GetUsers", "")
    if found {
        fmt.Println("Route:", route.Path, route.Method)
    }

    // Query struct field attributes
    idCol, found := runtime.GetAttr[attrs.Column]("main.User", "ID")
    if found {
        fmt.Println("ID column:", idCol.Name, "primary:", idCol.PrimaryKey)
    }
}
