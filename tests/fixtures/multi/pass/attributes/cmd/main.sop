package main

import "fmt"
import "github.com/halcyonnouveau/soppo/runtime"
import "github.com/test/attributes/attrs"

// Function with attribute
[attrs.Route{Path: "/users", Method: "GET"}]
func GetUsers() string {
    return "users"
}

// Type with attribute
[attrs.Route{Path: "/api"}]
type Handler struct {
    Name string
}

// Struct with field attributes (multi-line)
type User struct {
    [attrs.Column{
        Name: "user_id",
        PrimaryKey: true,
    }]
    ID string

    [attrs.Column{Name: "email"}]
    Email string
}

func main() {
    _ = GetUsers()

    // Query function attribute
    route, found := runtime.GetAttr[attrs.Route]("main.GetUsers", "")
    if found {
        fmt.Println("Route:", route.Path, route.Method)
    }

    // Query struct field attributes
    idCol, found := runtime.GetAttr[attrs.Column]("main.User", "ID")
    if found {
        fmt.Println("ID column:", idCol.Name, "primary:", idCol.PrimaryKey)
    }

    emailCol, found := runtime.GetAttr[attrs.Column]("main.User", "Email")
    if found {
        fmt.Println("Email column:", emailCol.Name)
    }

    // Check if type has Route attribute
    if runtime.HasAttr[attrs.Route]("main.Handler", "") {
        fmt.Println("Handler has Route attribute")
    }
}
