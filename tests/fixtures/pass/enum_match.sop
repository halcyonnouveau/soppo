package main

import "fmt"

type Color enum {
    Red
    Yellow
    Green
}

type MyResult enum {
    Ok int
    Err string
}

func unwrapOr(r MyResult, defaultVal int) int {
    var result int
    match r {
    case MyResult.Ok(value):
        result = value
    case MyResult.Err(msg):
        result = defaultVal
    }
    return result
}

func test() int {
    color := Color.Red

    var message string
    match color {
    case Color.Red:
        message = "Stop"
    case Color.Yellow:
        message = "Wait"
    case Color.Green:
        return 1
    }

   	fmt.Printf("%s\n", message)

    return 0
}

func main() {
    ok := MyResult.Ok(42)
    err := MyResult.Err("failed")

    result1 := unwrapOr(ok, 0)
    result2 := unwrapOr(err, 99)

   	fmt.Printf("%d %d %d\n", test(), result1, result2)
}
