package main

import "fmt"

type Color enum {
    Red
    Yellow
    Green
}

type MyResult enum {
    Ok int
    Err string
}

type Material enum {
    Wood string
    Metal string
}

type TriangleProps struct {
    material Material
}

type Shape enum {
    Circle struct {
        radius float64
    }
    Rectangle struct {
        width float64
        height float64
    }
    Triangle TriangleProps
}

func area(s Shape) float64 {
    var result float64
    match s {
    case Shape.Circle{radius: r, ...}:
        result = 3.14 * r * r
    case Shape.Rectangle{width: w, height: h}:
        result = w * h
    case Shape.Triangle(p):
        result = 0.0
    }
    return result
}

func testNestedMatch() string {
    mat := Material.Wood("oak")
    props := TriangleProps{material: mat}
    shape := Shape.Triangle(props)

    var result string
    match shape {
    case Shape.Circle{radius: r, ...}:
        result = "circle"
    case Shape.Rectangle{width: w, height: h}:
        result = "rectangle"
    case Shape.Triangle(p):
        match p.material {
        case Material.Wood(name):
            result = name
        case Material.Metal(name):
            result = name
        }
    }
    return result
}

func unwrapOr(r MyResult, defaultVal int) int {
    var result int
    match r {
    case MyResult.Ok(value):
        result = value
    case MyResult.Err(msg):
        result = defaultVal
    }
    return result
}

func test() int {
    color := Color.Red

    var message string
    match color {
    case Color.Red:
        message = "Stop"
    case Color.Yellow:
        message = "Wait"
    case Color.Green:
        return 1
    }

   	fmt.Printf("%s\n", message)

    return 0
}

// Multiple patterns in match arms
func isPrimary(c Color) bool {
    var result bool
    match c {
    case Color.Red, Color.Yellow:
        result = true
    case Color.Green:
        result = false
    }
    return result
}

// Expression-less match (like if/else chain)
func classify(x int) string {
    var result string
    match {
    case x > 0:
        result = "positive"
    case x < 0:
        result = "negative"
    default:
        result = "zero"
    }
    return result
}

// Multiple literal patterns
func isSmall(x int) bool {
    var result bool
    match x {
    case 1, 2, 3:
        result = true
    default:
        result = false
    }
    return result
}

func main() {
    ok := MyResult.Ok(42)
    err := MyResult.Err("failed")

    result1 := unwrapOr(ok, 0)
    result2 := unwrapOr(err, 99)

    circle := Shape.Circle{radius: 5.0}
    rect := Shape.Rectangle{width: 3.0, height: 4.0}

    nested := testNestedMatch()

   	fmt.Printf("%d %d %d %f %f %s\n", test(), result1, result2, area(circle), area(rect), nested)
}
