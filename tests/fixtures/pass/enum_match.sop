package main

import "fmt"

type Color enum {
    Red
    Yellow
    Green
}

type MyResult enum {
    Ok int
    Err string
}

type Shape enum {
    Circle struct {
        radius float64
    }
    Rectangle struct {
        width float64
        height float64
    }
}

func area(s Shape) float64 {
    var result float64
    match s {
    case Shape.Circle{radius: r, ...}:
        result = 3.14 * r * r
    case Shape.Rectangle{width: w, height: h}:
        result = w * h
    }
    return result
}

func unwrapOr(r MyResult, defaultVal int) int {
    var result int
    match r {
    case MyResult.Ok(value):
        result = value
    case MyResult.Err(msg):
        result = defaultVal
    }
    return result
}

func test() int {
    color := Color.Red

    var message string
    match color {
    case Color.Red:
        message = "Stop"
    case Color.Yellow:
        message = "Wait"
    case Color.Green:
        return 1
    }

   	fmt.Printf("%s\n", message)

    return 0
}

func main() {
    ok := MyResult.Ok(42)
    err := MyResult.Err("failed")

    result1 := unwrapOr(ok, 0)
    result2 := unwrapOr(err, 99)

    circle := Shape.Circle{radius: 5.0}
    rect := Shape.Rectangle{width: 3.0, height: 4.0}

   	fmt.Printf("%d %d %d %f %f\n", test(), result1, result2, area(circle), area(rect))
}
