package main

import "fmt"
import "strings"

// Constants
const MAX_SIZE int = 100
const PI float64 = 3.14159

// Type alias
type UserId int

// Struct definition
type User struct {
    id UserId
    name string
    age int
    active bool
}

// Struct with methods
type Counter struct {
    value int
}

func (c Counter) getValue() int {
    return c.value
}

func (c Counter) increment() Counter {
    c.value = c.value + 1
    return c
}

// Variadic function
func sum(numbers int) int {
    total := 0
    i := 0
    for i < 10 {
        total = total + numbers
        i = i + 1
    }
    return total
}

// String manipulation
func processString(s string) string {
    if s == "" {
        return "empty"
    }

    upper := strings.ToUpper(s)
    return upper
}

// Array/slice operations
func arrayOps() int {
    arr := [5]int{1, 2, 3, 4, 5}
    sum := 0

    i := 0
    for i < 5 {
        sum = sum + arr[i]
        i = i + 1
    }

    return sum
}

// Struct creation and field access
func createUser(name string, age int) User {
    user := User{
        id: UserId(1),
        name: name,
        age: age,
        active: true,
    }
    return user
}

// Conditionals and comparisons
func checkAge(age int) string {
    if age < 18 {
        return "minor"
    } else if age < 65 {
        return "adult"
    } else {
        return "senior"
    }
}

// Boolean logic
func validateInput(value int, enabled bool) bool {
    return enabled && value > 0 && value < MAX_SIZE
}

// Mathematical operations
func calculate(x int, y int) int {
    a := x + y
    b := x - y
    c := x * y
    d := x / y
    e := x % y

    result := a + b + c + d + e
    return result
}

func main() {
    var a = 1
    var b int = 1

    const c = 1
    const d int = 1

    // Integer operations
    x := 42
    y := 10 + a + b + c + d
    sum := x + y

    // Float operations
    radius := 5.0
    area := PI * radius * radius

    // String operations
    message := "Hello, World"
    processed := processString(message)

    // Boolean operations
    isValid := validateInput(50, true)

    // Struct operations
    user := createUser("Alice", 30)
    category := checkAge(user.age)

    // Counter with methods
    counter := Counter{value: 0}
    counter = counter.increment()
    count := counter.getValue()

    // Array operations
    arraySum := arrayOps()

    // Conditional
    status := ""
    if y > 0 {
        status = "success"
    } else {
        status = "failure"
    }

    // Print results
    fmt.Printf("Sum: %d\n", sum)
    fmt.Printf("Area: %f\n", area)
    fmt.Printf("Processed: %s\n", processed)
    fmt.Printf("Valid: %t\n", isValid)
    fmt.Printf("User: %s (%s)\n", user.name, category)
    fmt.Printf("Count: %d\n", count)
    fmt.Printf("Array sum: %d\n", arraySum)
    fmt.Printf("Status: %s\n", status)
}
