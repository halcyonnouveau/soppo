package basic

// Add returns the sum of two integers.
//
// ```sop
// import "fmt"
//
// result := Add(1, 2)
// fmt.Println(result)
// // Output:
// // 3
// ```
func Add(a int, b int) int {
	return a + b
}

// Multiply returns the product of two integers.
func Multiply(a int, b int) int {
	return a * b
}
