package main

import "fmt"

func main() {
    // Basic string interpolation
    name := "World"
    fmt.Println("Hello, {name}!")

    // Multiple interpolations
    x := 10
    y := 20
    fmt.Println("x={x}, y={y}, sum={x + y}")

    // Interpolation with method calls
    nums := []int{1, 2, 3}
    fmt.Println("Length: {len(nums)}")

    // Nested expressions
    a := 5
    b := 3
    fmt.Println("Result: {a * b + 2}")

    // Escaped braces (double braces)
    fmt.Println("Use {{name}} for interpolation")

    // No interpolation (plain string)
    fmt.Println("Just a plain string")

    // Percent signs in format (should be escaped in output)
    pct := 50
    fmt.Println("{pct}% complete")

    // Bool interpolation
    flag := true
    fmt.Println("Flag is {flag}")

    // Float interpolation
    pi := 3.14159
    fmt.Println("Pi is approximately {pi}")

    // Format specifiers
    // Integer formats
    num := 255
    fmt.Println("Decimal: {num:d}")
    fmt.Println("Binary: {num:b}")
    fmt.Println("Octal: {num:o}")
    fmt.Println("Hex lowercase: {num:x}")
    fmt.Println("Hex uppercase: {num:X}")
    fmt.Println("Hex with prefix: {num:#x}")
    fmt.Println("Zero-padded: {num:08d}")

    // Float formats
    price := 19.99
    fmt.Println("Float default: {price:f}")
    fmt.Println("Float precision: {price:.2f}")
    fmt.Println("Scientific: {price:e}")

    // String format
    greeting := "hello"
    fmt.Println("String: {greeting:s}")

    // Bool format
    active := true
    fmt.Println("Bool: {active:t}")

    // Generic %v format (works with any type)
    fmt.Println("Value: {nums:v}")
    fmt.Println("Go syntax: {nums:#v}")

    // Format with expressions
    fmt.Println("Sum: {x + y:d}")
    fmt.Println("Product: {float64(x) * 2.5:.1f}")

    // Format with slice access (colon in expression via slice syntax)
    arr := []int{10, 20, 30}
    fmt.Println("Array element: {arr[0]:d}")

    // Ternary-like with format
    val := 42
    fmt.Println("Result: {val:x}")
}
