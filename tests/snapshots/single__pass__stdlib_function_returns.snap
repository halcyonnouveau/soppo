//soppo:generated
package main

import "bytes"
import "context"
import "errors"
import "fmt"
import "regexp"
import "strings"
import "sync"
import "time"

// Test that stdlib function return types are correctly inferred
// This allows using methods on the returned values
func main() {
    // errors.New returns error
    err := errors.New("test error")
    if (err != nil) {
        _ = err.Error()
    }

    // fmt.Errorf returns error
    err2 := fmt.Errorf("formatted: %s", "test")
    if (err2 != nil) {
        _ = err2.Error()
    }

    // context.Background returns context.Context (interface, needs nil check)
    ctx := context.Background()
    if (ctx != nil) {
        _ = ctx.Done()
    }

    // context.TODO returns context.Context
    ctx2 := context.TODO()
    if (ctx2 != nil) {
        _ = ctx2.Done()
    }

    // time.Now returns time.Time (value type, no nil check needed)
    t := time.Now()
    _ = t.Unix()
    _ = t.Year()

    // bytes.NewBuffer returns *bytes.Buffer (use .(!nil) assertion)
    buf := bytes.NewBuffer([]byte{})
    _ = buf.Len()
    buf.WriteString("test")

    // bytes.NewBufferString returns *bytes.Buffer
    buf2 := bytes.NewBufferString("hello")
    _ = buf2.String()

    // strings.NewReader returns *strings.Reader
    reader := strings.NewReader("test")
    _ = reader.Len()

    // regexp.MustCompile returns *regexp.Regexp
    re := regexp.MustCompile(`\d+`)
    _ = re.MatchString("123")

    // sync.WaitGroup methods (value type)
    var wg sync.WaitGroup
    wg.Add(1)
    wg.Done()
    wg.Wait()
}
