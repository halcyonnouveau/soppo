package main

import "fmt"

type Color interface {
    isColor()
}

type Red struct {}
func (Red) isColor() {}
func (Red) String() string { return "Red" }

type Yellow struct {}
func (Yellow) isColor() {}
func (Yellow) String() string { return "Yellow" }

type Green struct {}
func (Green) isColor() {}
func (Green) String() string { return "Green" }

var (
    ColorRed Color = Red{}
    ColorYellow Color = Yellow{}
    ColorGreen Color = Green{}
)

type MyResult interface {
    isMyResult()
}

type Ok struct {
    Value int
}
func (Ok) isMyResult() {}

type Err struct {
    Value string
}
func (Err) isMyResult() {}

func MyResultOk(value int) MyResult {
    return Ok{Value: value}
}
func MyResultErr(value string) MyResult {
    return Err{Value: value}
}

func unwrapOr(r MyResult, defaultVal int) int {
    var result int
    switch __v := r.(type) {
    case Ok:
        value := __v.Value
        _ = value
        result = value
    case Err:
        msg := __v.Value
        _ = msg
        result = defaultVal
    }
    return result
}

func test() int {
    color := ColorRed
    var message string
    switch color.(type) {
    case Red:
        message = "Stop"
    case Yellow:
        message = "Wait"
    case Green:
        return 1
    }
    fmt.Printf("%s\n", message)
    return 0
}

func main() {
    ok := MyResultOk(42)
    err := MyResultErr("failed")
    result1 := unwrapOr(ok, 0)
    result2 := unwrapOr(err, 99)
    fmt.Printf("%d %d %d\n", test(), result1, result2)
}
