//soppo:generated
package main

import "fmt"

func main() {
	// Basic string interpolation
	name := "World"
	fmt.Println(fmt.Sprintf("Hello, %v!", name))

	// Multiple interpolations
	x := 10
	y := 20
	fmt.Println(fmt.Sprintf("x=%v, y=%v, sum=%v", x, y, x + y))

	// Interpolation with method calls
	nums := []int{1, 2, 3}
	fmt.Println(fmt.Sprintf("Length: %v", len(nums)))

	// Nested expressions
	a := 5
	b := 3
	fmt.Println(fmt.Sprintf("Result: %v", a * b + 2))

	// Escaped braces (double braces)
	fmt.Println("Use {name} for interpolation")

	// No interpolation (plain string)
	fmt.Println("Just a plain string")

	// Percent signs in format (should be escaped in output)
	pct := 50
	fmt.Println(fmt.Sprintf("%v%% complete", pct))

	// Bool interpolation
	flag := true
	fmt.Println(fmt.Sprintf("Flag is %v", flag))

	// Float interpolation
	pi := 3.14159
	fmt.Println(fmt.Sprintf("Pi is approximately %v", pi))

	// Format specifiers
	// Integer formats
	num := 255
	fmt.Println(fmt.Sprintf("Decimal: %d", num))
	fmt.Println(fmt.Sprintf("Binary: %b", num))
	fmt.Println(fmt.Sprintf("Octal: %o", num))
	fmt.Println(fmt.Sprintf("Hex lowercase: %x", num))
	fmt.Println(fmt.Sprintf("Hex uppercase: %X", num))
	fmt.Println(fmt.Sprintf("Hex with prefix: %#x", num))
	fmt.Println(fmt.Sprintf("Zero-padded: %08d", num))

	// Float formats
	price := 19.99
	fmt.Println(fmt.Sprintf("Float default: %f", price))
	fmt.Println(fmt.Sprintf("Float precision: %.2f", price))
	fmt.Println(fmt.Sprintf("Scientific: %e", price))

	// String format
	greeting := "hello"
	fmt.Println(fmt.Sprintf("String: %s", greeting))

	// Bool format
	active := true
	fmt.Println(fmt.Sprintf("Bool: %t", active))

	// Generic %v format (works with any type)
	fmt.Println(fmt.Sprintf("Value: %v", nums))
	fmt.Println(fmt.Sprintf("Go syntax: %#v", nums))

	// Format with expressions
	fmt.Println(fmt.Sprintf("Sum: %d", x + y))
	fmt.Println(fmt.Sprintf("Product: %.1f", float64(x) * 2.5))

	// Format with slice access (colon in expression via slice syntax)
	arr := []int{10, 20, 30}
	fmt.Println(fmt.Sprintf("Array element: %d", arr[0]))

	// Ternary-like with format
	val := 42
	fmt.Println(fmt.Sprintf("Result: %x", val))
}
