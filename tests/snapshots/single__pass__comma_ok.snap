//soppo:generated
package main

import "fmt"

func main() {
    // Type assertion comma-ok
    var x any = "hello"
    n, ok := x.(int)
    if ok {
        fmt.Println("int:", n)
    }

    // Map comma-ok
    m := map[string]int{"a": 1}
    v, exists := m["b"]
    if exists {
        fmt.Println("found:", v)
    }

    // Channel comma-ok
    ch := make(chan int, 1)
    ch <- 42
    val, open := (<-ch)
    if open {
        fmt.Println("received:", val)
    }
}
