package main

import "fmt"

/*soppo:enum
Color {
    Red
    Yellow
    Green
}
*/
type Color interface {
    isColor()
}

type Color_Red struct {}
func (Color_Red) isColor() {}
func (Color_Red) String() string { return "Red" }

type Color_Yellow struct {}
func (Color_Yellow) isColor() {}
func (Color_Yellow) String() string { return "Yellow" }

type Color_Green struct {}
func (Color_Green) isColor() {}
func (Color_Green) String() string { return "Green" }

var (
    ColorRed Color = Color_Red{}
    ColorYellow Color = Color_Yellow{}
    ColorGreen Color = Color_Green{}
)

/*soppo:enum
MyResult {
    Ok int
    Err string
}
*/
type MyResult interface {
    isMyResult()
}

type MyResult_Ok struct {
    Value int
}
func (MyResult_Ok) isMyResult() {}

type MyResult_Err struct {
    Value string
}
func (MyResult_Err) isMyResult() {}

func MyResultOk(value int) MyResult {
    return MyResult_Ok{Value: value}
}
func MyResultErr(value string) MyResult {
    return MyResult_Err{Value: value}
}

/*soppo:enum
Material {
    Wood string
    Metal string
}
*/
type Material interface {
    isMaterial()
}

type Material_Wood struct {
    Value string
}
func (Material_Wood) isMaterial() {}

type Material_Metal struct {
    Value string
}
func (Material_Metal) isMaterial() {}

func MaterialWood(value string) Material {
    return Material_Wood{Value: value}
}
func MaterialMetal(value string) Material {
    return Material_Metal{Value: value}
}

type TriangleProps struct {
    material Material
}

/*soppo:enum
Shape {
    Circle {
        radius float64
    }
    Rectangle {
        width float64
        height float64
    }
    Triangle TriangleProps
}
*/
type Shape interface {
    isShape()
}

type Shape_Circle struct {
    radius float64
}
func (Shape_Circle) isShape() {}

type Shape_Rectangle struct {
    width float64
    height float64
}
func (Shape_Rectangle) isShape() {}

type Shape_Triangle struct {
    Value TriangleProps
}
func (Shape_Triangle) isShape() {}

func ShapeTriangle(value TriangleProps) Shape {
    return Shape_Triangle{Value: value}
}

func area(s Shape) float64 {
    var result float64
    switch __v := s.(type) {
    case Shape_Circle:
        r := __v.radius
        _ = r
        result = ((3.14 * r) * r)
    case Shape_Rectangle:
        w := __v.width
        _ = w
        h := __v.height
        _ = h
        result = (w * h)
    case Shape_Triangle:
        p := __v.Value
        _ = p
        result = 0.0
    }
    return result
}

func testNestedMatch() string {
    mat := MaterialWood("oak")
    props := TriangleProps{material: mat}
    shape := ShapeTriangle(props)
    var result string
    switch __v := shape.(type) {
    case Shape_Circle:
        r := __v.radius
        _ = r
        result = "circle"
    case Shape_Rectangle:
        w := __v.width
        _ = w
        h := __v.height
        _ = h
        result = "rectangle"
    case Shape_Triangle:
        p := __v.Value
        _ = p
        switch __v := p.material.(type) {
        case Material_Wood:
            name := __v.Value
            _ = name
            result = name
        case Material_Metal:
            name := __v.Value
            _ = name
            result = name
        }
    }
    return result
}

func unwrapOr(r MyResult, defaultVal int) int {
    var result int
    switch __v := r.(type) {
    case MyResult_Ok:
        value := __v.Value
        _ = value
        result = value
    case MyResult_Err:
        msg := __v.Value
        _ = msg
        result = defaultVal
    }
    return result
}

func test() int {
    color := ColorRed
    var message string
    switch color.(type) {
    case Color_Red:
        message = "Stop"
    case Color_Yellow:
        message = "Wait"
    case Color_Green:
        return 1
    }
    fmt.Printf("%s\n", message)
    return 0
}

// Multiple patterns in match arms
func isPrimary(c Color) bool {
    var result bool
    switch c.(type) {
    case Color_Red, Color_Yellow:
        result = true
    case Color_Green:
        result = false
    }
    return result
}

// Expression-less match (like if/else chain)
func classify(x int) string {
    var result string
    switch {
    case (x > 0):
        result = "positive"
    case (x < 0):
        result = "negative"
    default:
        result = "zero"
    }
    return result
}

// Multiple literal patterns
func isSmall(x int) bool {
    var result bool
    switch x {
    case 1, 2, 3:
        result = true
    default:
        result = false
    }
    return result
}

func main() {
    ok := MyResultOk(42)
    err := MyResultErr("failed")
    result1 := unwrapOr(ok, 0)
    result2 := unwrapOr(err, 99)
    circle := Shape_Circle{radius: 5.0}
    rect := Shape_Rectangle{width: 3.0, height: 4.0}
    nested := testNestedMatch()
    fmt.Printf("%d %d %d %f %f %s\n", test(), result1, result2, area(circle), area(rect), nested)
}
