//soppo:generated v1
package main

import (
	"fmt"
)

type Address struct {
	city string
	zip string
}

type Profile struct {
	bio string
	address *Address
}

type User struct {
	name string
	age int
	profile *Profile //soppo:nilable
}

//soppo:nilable : 0
func getUser(id int) *User {
	return nil
}

func main() {
	// === Basic nil checks ===
	user := getUser(1)

	// After nil check, user is known to be non-nil
	if user != nil {
		fmt.Println(user.name)
	}

	// Early return pattern
	user2 := getUser(2)
	if user2 == nil {
		return
	}
	fmt.Println(user2.name)

	// Else branch knows opposite
	user3 := getUser(3)
	if user3 == nil {
		fmt.Println("not found")
	} else {
		fmt.Println(user3.name)
	}

	// === Automatically non-nil expressions ===
	// &expr is always non-nil
	u := User{name: "Alice", age: 30}
	ptr := (&u)
	fmt.Println(ptr.name)

	// new(T) is always non-nil
	newUser := new(User)
	newUser.name = "Bob"
	fmt.Println(newUser.name)

	// === Nested struct access ===
	user4 := getUser(4)
	if user4 != nil {
		fmt.Println(user4.name)

		// Direct field nil check works too
		if user4.profile != nil {
			fmt.Println(user4.profile.bio)

			// And deeper nesting
			if user4.profile.address != nil {
				fmt.Println(user4.profile.address.city)
			}
		}
	}

	// === .(!nil) escape hatch ===
	// When you know it's non-nil from external context
	user5 := getUser(5)
	fmt.Println(user5.name)

	// === Nil narrowing preserved in loops ===
	// Early return before loop
	user6 := getUser(6)
	if user6 == nil {
		return
	}
	for i := 0; i < 3; i++ {
		fmt.Println(user6.name) // user6 is non-nil here
	}

	// Nil check with nested loop
	user7 := getUser(7)
	if user7 != nil {
		for i := 0; i < 3; i++ {
			fmt.Println(user7.name) // user7 is non-nil in this block
		}
	}

	// === Nil narrowing with continue ===
	for i := 0; i < 3; i++ {
		u := getUser(i)
		if u == nil {
			continue
		}

		// After nil check with continue, u is known non-nil
		fmt.Println(u.name)
	}

	// === Nil narrowing in match statements ===
	// When match has `case nil:`, other branches know it's non-nil
	user8 := getUser(8)
	switch user8 {
	case nil:
		fmt.Println("not found")
	default:
		// In default branch, user8 is known to be non-nil
		fmt.Println(user8.name)
	}

	// Pointer type nil narrowing
	var tool *string
	switch tool {
	case nil:
		fmt.Println("no tool")
	default:
		// tool is non-nil here, can dereference
		fmt.Println((*tool))
	}
}
