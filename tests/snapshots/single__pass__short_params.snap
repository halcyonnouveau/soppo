//soppo:generated v1
package main

import "fmt"

func add(a int, b int) int {
	return a + b
}

func multiply(x int, y int, z int) int {
	return x * y * z
}

func greet(first string, last string) {
	fmt.Println("Hello", first, last)
}

func mixed(a int, b int, c string, d string) {
	fmt.Println(a, b, c, d)
}

func main() {
	fmt.Println(add(1, 2))
	fmt.Println(multiply(2, 3, 4))
	greet("John", "Doe")
	mixed(1, 2, "hello", "world")
}
